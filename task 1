// Лабораторна робота №9. Завдання 3, варіант 7
#include <iostream>
#include <iomanip>
#include <cmath>
using namespace std;

int main()
{
    const double X0 = 0, X1 = 2, Y0 = 1, Y1 = 2, H = 0.2;
    const double EPS = 1e-9;

    int nx = (int)floor((X1 - X0) / H + 1e-9) + 1;
    int ny = (int)floor((Y1 - Y0) / H + 1e-9) + 1;

    double f[20][20];

    cout << "Табуляція функції f(x, y) = ln(1 + sqrt(x + y))" << endl;
    cout << "x від " << X0 << " до " << X1 << ", y від " << Y0 << " до " << Y1
         << ", крок обох змінних " << H << endl << endl;

    cout << fixed << setprecision(1);
    cout << "  x \\ y |";
    for (int j = 0; j < ny; j++)
        cout << setw(8) << Y0 + j * H;
    cout << endl;

    cout << "--------+";
    for (int j = 0; j < ny; j++)
        cout << "--------";
    cout << endl;

    for (int i = 0; i < nx; i++)
    {
        double x = X0 + i * H;

        cout << setw(7) << fixed << setprecision(1) << x << " |";

        for (int j = 0; j < ny; j++)
        {
            double y = Y0 + j * H;
            f[i][j] = log(1 + sqrt(x + y));
            cout << setw(8) << fixed << setprecision(4) << f[i][j];
        }
        cout << endl;
    }

    double minF = f[0][0];
    double maxF = f[0][0];

    for (int i = 0; i < nx; i++)
    {
        for (int j = 0; j < ny; j++)
        {
            if (f[i][j] < minF)
                minF = f[i][j];
            if (f[i][j] > maxF)
                maxF = f[i][j];
        }
    }

    int minCount = 0;
    int maxCount = 0;

    for (int i = 0; i < nx; i++)
    {
        for (int j = 0; j < ny; j++)
        {
            if (fabs(f[i][j] - minF) < EPS)
                minCount++;
            if (fabs(f[i][j] - maxF) < EPS)
                maxCount++;
        }
    }

    cout << endl << setprecision(6);
    cout << "Мінімальне значення функції: " << minF << ", зустрічається разів: " << minCount << endl;
    cout << "Максимальне значення функції: " << maxF << ", зустрічається разів: " << maxCount << endl;

    return 0;
}
